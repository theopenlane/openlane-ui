{
  "name": "openlane-ui",
  "version": "1.0.0",
  "description": "A monorepo for openlane UI apps and supporting libraries",
  "repository": "git@github.com:theopenlane/openlane-ui.git",
  "author": "openlane <info@theopenlane.io>",
  "license": "Apache-2.0",
  "private": true,
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev --parallel",
    "debug": "turbo debug",
    "type-check": "turbo type-check",
    "clean": "rm -rf node_modules/** && rm -rf ./apps/console/.next && rm -rf ./apps/console/node_modules && rm -rf ./apps/storybook/.next && rm -rf ./apps/storybook/node_modules &&  rm -rf ./packages/*/node_modules",
    "turbo-clean": "turbo clean",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,css,scss,json,yaml,yml,md,graphql,gql}": "prettier --write",
    "apps/console/**/*.{js,jsx,ts,tsx}": "eslint --no-warn-ignored --max-warnings=0 --fix"
  },
  "devDependencies": {
    "@eslint-react/eslint-plugin": "^5.18.3",
    "@types/dompurify": "^3.2.0",
    "dompurify": "^3.4.13",
    "dotenv-cli": "^11.0.0",
    "eslint": "10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.10.9",
    "typescript": "^6.0.3"
  },
  "engines": {
    "node": "24.18.x"
  },
  "packageManager": "bun@1.3.13",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "trustedDependencies": [
    "core-js"
  ],
  "resolutions": {
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@xmldom/xmldom": "^0.9.0",
    "fast-uri": "^4.1.2",
    "form-data": "^4.0.6",
    "postcss": "^8.5.26",
    "next": "16.3.0",
    "effect": "^3.21.4",
    "dompurify": "^3.4.13",
    "graphql": "17.0.2",
    "redux": "^5.0.1",
    "sharp": "^0.35.0",
    "uuid": "^11.1.1",
    "xmlbuilder2": "^4.0.3"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "dependencies": {
    "@emoji-mart/data": "^1.2.1",
    "@emoji-mart/react": "^1.1.1",
    "@google-cloud/aiplatform": "^6.11.0",
    "@google-cloud/storage": "^7.21.0",
    "@google/genai": "^2.16.0",
    "@platejs/docx-io": "^53.3.2",
    "@radix-ui/react-icons": "^1.3.2",
    "@react-pdf/renderer": "^4.5.1",
    "@types/file-saver": "^2.0.7",
    "@xyflow/react": "^12.11.2",
    "docx": "^9.7.1",
    "emoji-mart": "^5.6.0",
    "file-saver": "^2.0.5"
  }
}
