# Console build/runtime settings for the nightly e2e run against a local core on :17608.
# Non-secret by design: AUTH_SECRET is generated per run by run-shard.sh, and every
# third-party feature (AI, chat, analytics, billing) is off so the suite never calls out.
NEXT_PUBLIC_OPENLANE_URL=http://e2e.theopenlane.io:17608
NEXT_PUBLIC_API_GQL_URL=http://e2e.theopenlane.io:17608/query
API_GQL_URL=http://localhost:17608/query
API_REST_URL=http://localhost:17608
SESSION_COOKIE_NAME=temporary-cookie
SESSION_COOKIE_EXPIRATION_MINUTES=60
COOKIE_DOMAIN=e2e.theopenlane.io
AUTH_TRUST_HOST=true
COOKIE_PLAYWRIGHT_INSECURE=true
NEXT_PUBLIC_ENABLE_CHATBOT=false
NEXT_PUBLIC_AI_SUGGESTIONS_ENABLED=false
NEXT_PUBLIC_DOCS_HELP_ENABLED=false
NEXT_PUBLIC_ENABLE_PLAN=false
NEXT_PUBLIC_INCLUDE_QUESTIONNAIRE_CREATION=true
NEXT_TELEMETRY_DISABLED=1
HUSKY=0
